{
  "openapi": "3.0.3",
  "info": {
    "title": "Ridebook API",
    "version": "0.1.0"
  },
  "components": {
    "schemas": {}
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Service and database health",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "database": {
                      "type": "object",
                      "properties": {
                        "connected": {
                          "type": "boolean"
                        },
                        "postgis": {
                          "nullable": true,
                          "type": "string"
                        }
                      },
                      "required": [
                        "connected",
                        "postgis"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "status",
                    "database"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "tags": [
    {
      "name": "system",
      "description": "Health and diagnostics"
    },
    {
      "name": "pois",
      "description": "Points of interest"
    },
    {
      "name": "trips",
      "description": "Trips and itineraries"
    },
    {
      "name": "routes",
      "description": "Trip routes"
    },
    {
      "name": "geocoding",
      "description": "Place search"
    }
  ]
}
