# Copy to .env and fill in. A single root .env serves docker compose, the API and Vite.

# --- Database (docker compose + API) ---
POSTGRES_USER=ridebook
POSTGRES_PASSWORD=ridebook
POSTGRES_DB=ridebook
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ridebook:ridebook@localhost:5432/ridebook

# --- API ---
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# --- External providers (server-side only, never exposed to the browser) ---
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org

# --- Auth (added in phase P8; leave blank until then) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=
# Comma-separated list of Google account emails granted OWNER role.
ALLOWED_EMAILS=

# --- Frontend (VITE_ vars are bundled into the browser build and are public) ---
VITE_API_URL=http://localhost:3000
# Public by design. Restrict it to your domains in the MapTiler dashboard.
VITE_MAPTILER_KEY=
